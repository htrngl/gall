#!/bin/sh
# gall up [ctx] | down | log: the server on port 9940. anything else goes
# to the engine under ./wd (gall check $M ref/short, ...)
cd "$(dirname "$(readlink -f "$0")")" && . ./env && export M
B=target/release/gall L=scratch/serve.log
ok() { curl -sf -m1 127.0.0.1:9940/health >/dev/null; }
case $1 in
up) ok && exit; mkdir -p scratch
  nohup ./wd $B serve $M --ctx ${2:-32768} >$L 2>&1 & p=$!
  until ok; do kill -0 $p 2>/dev/null || { tail -3 $L; exit 1; }; sleep 1
  done; echo up ;;
down) pkill -f "$B serve" && echo down ;;
log) tail -f $L ;;
*) exec ./wd $B "$@" ;;
esac
