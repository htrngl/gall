From 9910fd68d8e85845d0e021abd63fe38c9aea553e Mon Sep 17 00:00:00 2001
From: mix <mix@localhost>
Date: Sat, 21 Nov 2026 13:56:30 +0000
Subject: [PATCH 7/7] inkling2 : decode graph trims: one-token rel bias gather
 (up to 2 tables of rows), mix stacks the normalized blocks once, clip divides
 by the clamped norm

---
 src/models/inkling2.cpp | 55 +++++++++++++++++++++++++++++++----------
 src/models/models.h     |  4 +++
 2 files changed, 46 insertions(+), 13 deletions(-)

diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index e6e541578..338ee06e2 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -176,27 +176,50 @@ ggml_tensor * llama_model_inkling2::graph::clip(ggml_tensor * cur, ggml_tensor *
     }
 
     ggml_tensor * norm = ggml_sqrt(ctx0, ggml_sum_rows(ctx0, ggml_sqr(ctx0, cur)));
-    norm = ggml_scale_bias(ctx0, norm, 1.0f, 1e-6f);
 
-    ggml_tensor * factor = ggml_div(ctx0, ggml_fill(ctx0, norm, threshold), norm);
+    // cur*min(1, threshold/(norm + 1e-6))
+    norm = ggml_clamp(ctx0, ggml_scale_bias(ctx0, norm, 1.0f/threshold, 1e-6f/threshold), 1.0f, INFINITY);
 
-    return ggml_mul(ctx0, cur, ggml_clamp(ctx0, factor, 0.0f, 1.0f));
+    return ggml_div(ctx0, cur, norm);
+}
+
+// the normalized states, stacked; each list of states is stacked one time
+ggml_tensor * llama_model_inkling2::graph::stack(const std::vector<ggml_tensor *> & states) {
+    ggml_tensor *& res = stacks[states];
+    if (!res) {
+        res = ggml_rms_norm(ctx0, ggml_reshape_3d(ctx0, states.back(), n_embd, 1, n_tokens), 1e-6f);
+        if (states.size() > 1) {
+            res = ggml_concat(ctx0, stack({states.begin(), states.end() - 1}), res, 1);
+        }
+    }
+    return res;
 }
 
 // attention over the depth: mix the earlier block outputs and cur with learned queries
 ggml_tensor * llama_model_inkling2::graph::mix(const std::vector<ggml_tensor *> & blocks, ggml_tensor * cur, ggml_tensor * query) {
-    ggml_tensor * states = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
-    for (ggml_tensor * block : blocks) {
-        states = ggml_concat(ctx0, ggml_reshape_3d(ctx0, block, n_embd, 1, n_tokens), states, 1);
-    }
-    states = ggml_rms_norm(ctx0, states, 1e-6f);
+    std::vector<ggml_tensor *> all = blocks;
+    all.push_back(cur);
+    ggml_tensor * states = stack(all);
 
-    ggml_tensor * queries = ggml_repeat(ctx0, query, ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, n_embd, query->ne[1], n_tokens));
+    ggml_tensor * queries = n_tokens == 1 ? query : ggml_repeat(ctx0, query, ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, n_embd, query->ne[1], n_tokens));
 
     ggml_tensor * scores = ggml_mul_mat(ctx0, states, queries);
     scores = ggml_soft_max_ext(ctx0, scores, nullptr, 1.0f/sqrtf(n_embd), 0.0f);
 
-    return ggml_mul_mat(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, states)), scores);
+    ggml_tensor *& states_t = stacks_t[states];
+    if (!states_t) {
+        states_t = ggml_cont(ctx0, ggml_transpose(ctx0, states));
+    }
+
+    return ggml_mul_mat(ctx0, states_t, scores);
+}
+
+// row j of a mix as [n_embd, n_tokens]
+ggml_tensor * llama_model_inkling2::graph::mix_row(ggml_tensor * mixed, int64_t j) {
+    if (n_tokens == 1) {
+        return ggml_view_2d(ctx0, mixed, n_embd, 1, mixed->nb[1], j*mixed->nb[1]);
+    }
+    return ggml_cont(ctx0, ggml_view_2d(ctx0, mixed, n_embd, n_tokens, mixed->nb[2], j*mixed->nb[1]));
 }
 
 // causal short convolution with a residual; dynamic adds input-dependent taps per head
@@ -334,7 +357,7 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
 
     // the message of controller ctrl, [n_embd, n_tokens]
     auto message = [&](int ctrl) {
-        return ggml_cont(ctx0, ggml_view_2d(ctx0, messages, n_embd, n_tokens, messages->nb[2], ctrl*messages->nb[1]));
+        return mix_row(messages, ctrl);
     };
 
     ggml_tensor * state   = recr->mctx->get_r_l(il);
@@ -348,7 +371,7 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
     if (layer.attn_res_query) {
         ggml_tensor * mixed = mix(blocks, cur, layer.attn_res_query);
         for (int j = 0; j < 3; ++j) {
-            inputs[j] = ggml_cont(ctx0, ggml_view_2d(ctx0, mixed, n_embd, n_tokens, mixed->nb[2], (is_swa ? 0 : j)*mixed->nb[1]));
+            inputs[j] = mix_row(mixed, is_swa ? 0 : j);
         }
     }
 
@@ -459,6 +482,7 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
             table = ggml_sub(ctx0, table, ggml_reshape_3d(ctx0, sinks, 1, n_head, n_tokens));
             table = ggml_cont(ctx0, ggml_permute(ctx0, table, 1, 0, 2, 3));
 
+            ggml_tensor * sinks_q = sinks;
             sinks = ggml_fill(ctx0, ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_head), 0.0f);
 
             // dense bias is n_kv x n_tokens x n_head: chunk query rows past the budget
@@ -482,7 +506,12 @@ ggml_tensor * llama_model_inkling2::graph::build_layer(int il, int ip, ggml_tens
                 const bool all = nr == n_seq_tokens;
                 ggml_tensor * q_c = Qcur;
                 ggml_tensor * kq_b = nullptr;
-                if (all) {
+                if (n_tokens == 1 && n_kv <= 2*layer.attn_rel_bias->ne[1]) {
+                    // one token: gather the bias rows, then project them, kq_b is [n_kv, n_head]; cheaper up to about 2 tables of rows
+                    kq_b = ggml_get_rows(ctx0, ggml_pad(ctx0, layer.attn_rel_bias, 0, 1, 0, 0), rel_pos);
+                    kq_b = ggml_sub(ctx0, ggml_mul_mat(ctx0, kq_b, Rcur), ggml_reshape_2d(ctx0, sinks_q, 1, n_head));
+                    kq_b = ggml_reshape_4d(ctx0, kq_b, n_kv, 1, n_head, 1);
+                } else if (all) {
                     kq_b = ggml_get_rows(ctx0, table, rel_pos);
                     kq_b = ggml_reshape_4d(ctx0, kq_b, n_head, n_kv, nr, n_stream);
                     kq_b = ggml_cont(ctx0, ggml_permute(ctx0, kq_b, 2, 0, 1, 3));
diff --git a/src/models/models.h b/src/models/models.h
index e62aea837..755683dc1 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -2568,7 +2568,11 @@ struct llama_model_inkling2 : public llama_model_base {
 
     struct graph : public llm_graph_context {
         graph(const llm_graph_params & params);
+        std::map<std::vector<ggml_tensor *>, ggml_tensor *> stacks;
+        std::map<ggml_tensor *, ggml_tensor *> stacks_t; // transposed
+        ggml_tensor * stack(const std::vector<ggml_tensor *> & states);
         ggml_tensor * mix(const std::vector<ggml_tensor *> & blocks, ggml_tensor * cur, ggml_tensor * query);
+        ggml_tensor * mix_row(ggml_tensor * mixed, int64_t j);
         ggml_tensor * clip(ggml_tensor * cur, ggml_tensor * scale, float threshold);
         ggml_tensor * convolve(
                 ggml_tensor * cur,
