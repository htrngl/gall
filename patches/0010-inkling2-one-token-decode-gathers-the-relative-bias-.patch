From cea09331d5b68a82d04df6e2a90dbd9a21888513 Mon Sep 17 00:00:00 2001
From: Louis Goddard <louisgoddard@gmail.com>
Date: Sat, 21 Nov 2026 00:01:47 +0000
Subject: [PATCH 10/10] inkling2 : one-token decode gathers the relative bias
 rows first up to 2x the table rows

---
 src/models/inkling2.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/models/inkling2.cpp b/src/models/inkling2.cpp
index 285074bea..c3977a33f 100644
--- a/src/models/inkling2.cpp
+++ b/src/models/inkling2.cpp
@@ -577,8 +577,8 @@ llama_model_inkling2::graph::graph(const llm_graph_params & params) : llm_graph_
                     const bool all = nr == n_seq_tokens;
                     ggml_tensor * q_c = Qcur;
                     ggml_tensor * kq_b = nullptr;
-                    if (n_tokens == 1 && n_kv <= layer.attn_rel_bias->ne[1]) {
-                        // one token: gather the bias rows, then project them, kq_b is [n_kv, n_head]
+                    if (n_tokens == 1 && n_kv <= 2*layer.attn_rel_bias->ne[1]) {
+                        // one token: gather the bias rows, then project them, kq_b is [n_kv, n_head]; cheaper up to about 2 tables of rows
                         kq_b = ggml_get_rows(ctx0, ggml_pad(ctx0, layer.attn_rel_bias, 0, 1, 0, 0), rel_pos);
                         kq_b = ggml_sub(ctx0, ggml_mul_mat(ctx0, kq_b, Rcur), ggml_reshape_2d(ctx0, sinks_q, 1, n_head));
                         kq_b = ggml_reshape_4d(ctx0, kq_b, n_kv, 1, n_head, 1);
