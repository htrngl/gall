 bool ggml_metal_op_flash_attn_ext_use_vec(const ggml_tensor * op) {
-    assert(op->op == GGML_OP_FLASH_ATTN_EXT);
+    assert((op->op == GGML_OP_FLASH_ATTN_EXT || op->op == GGML_OP_FLASH_ATTN_EXT_BANDED));
 
     const int64_t ne00 = op->src[0]->ne[0]; // head size
     const int64_t ne01 = op->src[0]->ne[1]; // batch size
 
+    // the banded bias is in the half8x8 kernel only
+    if (op->op == GGML_OP_FLASH_ATTN_EXT_BANDED) {
+        return false;
+    }
+
     // use vec kernel if the batch size is small and if the head size is supported
     return (ne01 < 20) && (ne00 % 32 == 0);
 }
@@ -3211,11 +3217,16 @@ bool ggml_metal_op_flash_attn_ext_use_vec(const ggml_tensor * op) {
 // ref: https://github.com/ggml-org/llama.cpp/pull/27390
