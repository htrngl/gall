From c931f8ba079d9d2323623b65e2f919cb1c74f4d8 Mon Sep 17 00:00:00 2001
From: Louis Goddard <louisgoddard@gmail.com>
Date: Fri, 20 Nov 2026 23:18:07 +0000
Subject: [PATCH 2/7] metal : nvfp4 mul_mv takes half a sub-block per thread
 and 4 rows per simdgroup

---
 ggml/src/ggml-metal/ggml-metal-impl.h    |  2 +-
 ggml/src/ggml-metal/kernels/mul_mv.metal | 42 ++++++++----------------
 2 files changed, 15 insertions(+), 29 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-impl.h b/ggml/src/ggml-metal/ggml-metal-impl.h
index 36d18d161..28fd3f1e3 100644
--- a/ggml/src/ggml-metal/ggml-metal-impl.h
+++ b/ggml/src/ggml-metal/ggml-metal-impl.h
@@ -50,7 +50,7 @@
 #define N_R0_MXFP4 2
 #define N_SG_MXFP4 2
 
-#define N_R0_NVFP4 2
+#define N_R0_NVFP4 4
 #define N_SG_NVFP4 2
 
 #define N_R0_Q2_K 4
diff --git a/ggml/src/ggml-metal/kernels/mul_mv.metal b/ggml/src/ggml-metal/kernels/mul_mv.metal
index 49a31e4e0..496a2da9e 100644
--- a/ggml/src/ggml-metal/kernels/mul_mv.metal
+++ b/ggml/src/ggml-metal/kernels/mul_mv.metal
@@ -3183,47 +3183,33 @@ void kernel_mul_mv_nvfp4_f32_impl(
     const int nb   = args.ne00/QK_NVFP4;
     const int ns01 = args.nb01/args.nb00; // this can be larger than nb for permuted src0 tensors
 
-    const short ix = tiisg/2;  // 0...15
-    const short it = tiisg%2;  // 0 or 1, each thread takes 2 of the 4 sub-blocks
-
     shmem_f32[tiisg] = kvalues_mxfp4_f[tiisg%16];
     threadgroup_barrier(mem_flags::mem_threadgroup);
 
-    float4 yl[8];
-    float sumf[NR0]={0.f};
+    const short ix = tiisg/8;  // 0...3
+    const short it = tiisg%8;  // each thread takes half of 1 of the 4 sub-blocks
+    const short is = it/2;
+    const short ih = it%2;
 
-    device const float * yb = y + ix*QK_NVFP4 + it*2*QK_NVFP4_SUB;
+    float sumf[NR0]={0.f};
 
-    for (int ib = ix; ib < nb && ib < ns01; ib += 16) {
-        device const float4 * y4 = (device const float4 *) yb;
+    device const float4 * yb = (device const float4 *) (y + ix*QK_NVFP4 + is*QK_NVFP4_SUB) + ih;
 
-        FOR_UNROLL (short i = 0; i < 8; ++i) {
-            yl[i] = y4[i];
-        }
+    for (int ib = ix; ib < nb && ib < ns01; ib += 4) {
+        const float4 y0 = yb[0];
+        const float4 y1 = yb[2];
 
         FOR_UNROLL (short row = 0; row < NR0; row++) {
             device const block_nvfp4 & xb = x[row*ns01 + ib];
-            device const uint8_t     * q2 = xb.qs + 2*it*(QK_NVFP4_SUB/2);
-
-            float sumq = 0.f;
-
-            FOR_UNROLL (short s = 0; s < 2; ++s) {
-                device const uint8_t * q = q2 + 8*s;
+            device const uint8_t     * q  = xb.qs + is*(QK_NVFP4_SUB/2) + 4*ih;
 
-                float4 acc1 = yl[4*s + 0]*float4(shmem_f32[q[0] &  0x0F], shmem_f32[q[1] &  0x0F], shmem_f32[q[2] &  0x0F], shmem_f32[q[3] &  0x0F]);
-                float4 acc2 = yl[4*s + 1]*float4(shmem_f32[q[4] &  0x0F], shmem_f32[q[5] &  0x0F], shmem_f32[q[6] &  0x0F], shmem_f32[q[7] &  0x0F]);
-                float4 acc3 = yl[4*s + 2]*float4(shmem_f32[q[0] >> 4   ], shmem_f32[q[1] >> 4   ], shmem_f32[q[2] >> 4   ], shmem_f32[q[3] >> 4   ]);
-                float4 acc4 = yl[4*s + 3]*float4(shmem_f32[q[4] >> 4   ], shmem_f32[q[5] >> 4   ], shmem_f32[q[6] >> 4   ], shmem_f32[q[7] >> 4   ]);
+            const float4 acc = y0*float4(shmem_f32[q[0] &  0x0F], shmem_f32[q[1] &  0x0F], shmem_f32[q[2] &  0x0F], shmem_f32[q[3] &  0x0F]) +
+                               y1*float4(shmem_f32[q[0] >> 4   ], shmem_f32[q[1] >> 4   ], shmem_f32[q[2] >> 4   ], shmem_f32[q[3] >> 4   ]);
 
-                acc1 = (acc1 + acc3) + (acc2 + acc4);
-
-                sumq += ue4m3_to_fp32(xb.d[2*it + s]) * ((acc1[0] + acc1[1]) + (acc1[2] + acc1[3]));
-            }
-
-            sumf[row] += sumq;
+            sumf[row] += ue4m3_to_fp32(xb.d[is]) * ((acc[0] + acc[1]) + (acc[2] + acc[3]));
         }
 
-        yb += 16 * QK_NVFP4;
+        yb += QK_NVFP4; // 4 blocks of float4
     }
 
     device float * dst_f32 = (device float *) dst + (uint64_t)im*args.ne0*args.ne1 + (uint64_t)r1*args.ne0;
-- 
2.50.1 (Apple Git-155)

