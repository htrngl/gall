#!/bin/sh
# target/Gall.app and Gall.dmg (+ .sha256), signed with $GALL_SIGN (ad hoc
# without it); with $GALL_NOTARY (a notarytool keychain profile) and a
# developer id in $GALL_SIGN, the dmg is notarized and stapled too
set -eu
cd "$(dirname "$0")/.."
S=${GALL_SIGN:--} N=${GALL_NOTARY:-}
[ -z "$N" ] || [ "$S" != - ] || { echo 'mac/build: notary needs GALL_SIGN' >&2
  exit 1; }
# MTLCompileOptions.mathMode needs macOS 15
export MACOSX_DEPLOYMENT_TARGET=15.0
cargo build --release
swift build -c release --package-path mac
a=target/Gall.app c=target/Gall.app/Contents d=target/Gall.dmg
rm -rf $a $d* && mkdir -p $c/MacOS $c/Resources
# the swift binary is GallMenu: on a case-insensitive disk, Gall is gall
cp "$(swift build -c release --package-path mac --show-bin-path)/GallMenu" \
  target/release/gall $c/MacOS/
v=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
sed "s|<string>0</string>|<string>$v</string>|" mac/Info.plist >$c/Info.plist
cp mac/AppIcon.icns mac/send LICENSE NOTICE $c/Resources/
t=$([ "$S" = - ] || echo --timestamp)
s() { codesign -f -s "$S" $t "$@"; }
s --options runtime --entitlements mac/gall.entitlements $c/MacOS/gall
s --options runtime --entitlements mac/gall.entitlements $a
codesign --verify --deep --strict $a
# the dmg holds the app and a link to /Applications
x=$(mktemp -d) && trap 'rm -rf "$x"' EXIT
cp -R $a "$x" && ln -s /Applications "$x"
hdiutil create -volname Gall -srcfolder "$x" -format UDZO $d
[ "$S" = - ] || s $d
if [ "$N" ]; then
  xcrun notarytool submit $d --keychain-profile "$N" --wait
  xcrun stapler staple $d && xcrun stapler validate $d
fi
(cd target && shasum -a 256 Gall.dmg >Gall.dmg.sha256)
