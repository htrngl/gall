#!/bin/sh
# the telegram bridge: Gall.app runs it while "Telegram bridge" is on and
# kills its process group on a toggle or a quit. it long-polls the bot and
# hands each message from an allowed id to a coding agent, one at a time.
# ~/.config/gall/bridge (sh) sets TELEGRAM_BOT_TOKEN, TELEGRAM_ALLOWED_USERS
# (comma separated), and optionally BOT_DIR, TIMEOUT (seconds) and AGENT: a
# command that reads the message on stdin and writes the answer on stdout.
# it runs in BOT_DIR with GALL_URL, GALL_KEY, GALL_MODEL, and CONTINUE
# (empty for a new conversation). the default, hax, also streams its tool
# calls to .jl for the draft
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
c=~/.config/gall/bridge; [ -r "$c" ] && . "$c" && [ "$TELEGRAM_BOT_TOKEN" ] ||
  { echo "no TELEGRAM_BOT_TOKEN in $c"; exit 1; }
[ "$AGENT" ] || AGENT='hax --json ${CONTINUE:+--continue} \
  --provider=llamacpp --model=$GALL_MODEL | tee .jl |
  jq -r "select(.type == \"result\") | .text // .error"'
api=https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN g=http://127.0.0.1:9940
d=${BOT_DIR:-$HOME/Gall}; mkdir -p "$d"; cd "$d" || exit 1; o=0
[ -e AGENTS.md ] || echo "Telegram shows your replies as plain text: never \
use markdown (no asterisks, headings, backticks or tables)." >AGENTS.md
export GALL_URL=$g/v1 GALL_MODEL=inkling-2-mini \
  GALL_KEY=$(cat ~/.cache/gall/key 2>/dev/null || echo none)
# hax as a llama.cpp client of gall, compacting before the app's window fills
x=$(defaults read io.github.ltrgoddard.gall ctx 2>/dev/null)
export HAX_LLAMACPP_BASE_URL=$GALL_URL HAX_LLAMACPP_API_KEY=$GALL_KEY \
  HAX_CONTEXT_LIMIT=${x:-102400} HAX_MAX_TURNS=0 HAX_IMAGE_INPUT=on
send() { printf %s "$2" | jq -Rsc --arg c "$1" '(if . == "" then "(no output)"
  else . end) | [range(0; length; 4000) as $i
  | {chat_id: $c, text: .[$i:$i+4000]}][]' | while read -r j; do
  curl -s -m 30 -H 'content-type: application/json' -d "$j" \
    "$api/sendMessage" >/dev/null; done; }
# while the agent ($2) runs, a draft (gone with the answer) shows the tool
# hax ran last; a new message (which runs next) or TIMEOUT
# stops the agent and its processes
watch() { n=0 y=-; while sleep 4; do n=$((n + 4))
  # "$ git status …", "read README.md": a command's first line, without a
  # leading cd, or a file's name, cut at a word near 40 characters
  x=$(grep -s '"kind":"tool_call"' .jl | tail -1 | jq -r '.tool_name as $t
    | (try (.arguments | fromjson) catch {}) as $a | $a.command
    // ($a.path | values | sub(".*/"; "")) // "" | tostring
    | split("\n")[0] // "" | sub("^ *cd [^ ]+ *(&&|;) *"; "")
    | gsub("\\s+"; " ") | if length > 40 then .[:40] | sub(" [^ ]*$"; "")
      + " …" else . end | if . == "" then $t elif $t == "bash" then "$ \(.)"
      else "\($t) \(.)" end')
  # a draft is typed out again when it changes: send a new one, or each 20 s
  [ "$x" != "$y" ] || [ $((n % 20)) = 0 ] && y=$x &&
    curl -s -m 5 "$api/sendMessageDraft" -d chat_id=$1 -d draft_id=1 \
      --data-urlencode "text=${x:-working}" >/dev/null
  x=$(curl -s -m 5 "$api/getUpdates?offset=$o" | jq -r --argjson s \
    "$(cat .stop 2>/dev/null || echo 0)" --arg a ",$TELEGRAM_ALLOWED_USERS," \
    '[.result[]? | select(.update_id > $s and (.message.text or .message.photo)
    and (",\(.message.from.id)," as $f | $a | contains($f))) | .update_id]
    | max // ""')
  [ -n "$x" ] && { echo $x >.stop; send "$1" stopping; break; }
  [ $n -lt "${TIMEOUT:-1800}" ] || { send "$1" "timed out"; break; }
done; pkill -P $2; kill $2; }
# the bot's command menu is the commands this script handles
curl -s -m 30 "$api/setMyCommands" -H 'content-type: application/json' -d \
  '{"commands":[{"command":"new","description":"start a new conversation"}]}' \
  >/dev/null
while :; do
  # the app kills a poll that a sleep left dead: poll again soon
  r=$(curl -s -m 70 "$api/getUpdates?timeout=60&offset=$o") || { sleep 2
    continue; }
  o=$(printf "%s\n" "$r" | jq --argjson o $o '[.result[]?.update_id] | max
    | if . then . + 1 else $o end')
  printf "%s\n" "$r" | jq -c '.result[]?.message | select(.text or .photo)
    | [.chat.id, .from.id, .text // .caption // "", (.photo // [] | last
    | .file_id // "")]' | while read -r x; do
    ch=$(printf %s "$x" | jq -r '.[0]') f=$(printf %s "$x" | jq -r '.[1]')
    t=$(printf %s "$x" | jq -r '.[2]') ph=$(printf %s "$x" | jq -r '.[3]')
    case ",$TELEGRAM_ALLOWED_USERS," in *",$f,"*) ;; *)
      echo "ignored a message from $f"; continue;; esac
    case $t in /new) rm -f .cont
      send "$ch" "new conversation"; continue;; esac
    # a photo lands in img/ and the model looks at it with its read tool
    [ -z "$ph" ] || { ph=$(curl -s -m 30 "$api/getFile?file_id=$ph" |
        jq -r '.result.file_path // ""'); mkdir -p img
      curl -sf -m 60 -o "img/${ph##*/}" "${api%/bot*}/file/${api##*/}/$ph" &&
        t="$t
(the user sent an image: $PWD/img/${ph##*/}. read it to see it.)"; }
    printf "%s %s: %s\n" "$(date "+%F %T")" "$f" "$t"
    touch ~/.cache/gall/bridge.run # the app keeps the mac awake for it
    # the server restarts when a setting changes: wait for it
    i=0; until curl -sf -m 5 $g/health >/dev/null || [ $i = 60 ]; do
      i=$((i + 1)); sleep 2; done
    [ -e .cont ] && export CONTINUE=1 || export CONTINUE=; rm -f .jl
    printf %s "$t" | sh -c "$AGENT" >.out 2>.err & a=$!
    watch "$ch" $a & w=$!; wait $a; s=$?; kill $w 2>/dev/null; touch .cont
    [ $s = 0 ] && send "$ch" "$(cat .out)" ||
      send "$ch" "$(cat .out; grep -v '^resume with' .err | tail -4)"
    rm -f ~/.cache/gall/bridge.run
  done
done
